<plist version="1.0">
<dict>
  <key>Label</key><string>com.qwen.gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/user/Projects/qwen36-35b-a3b/qwen-server/target/release/qwen-gateway</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>RUST_LOG</key><string>info</string>
