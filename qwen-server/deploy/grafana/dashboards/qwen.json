{
  "title": "qwen-server",
  "uid": "qwen-server",
  "schemaVersion": 39,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "5s",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat", "title": "Worker up", "id": 1,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "qwen_worker_up", "refId": "A" }]
    },
    {
      "type": "stat", "title": "In flight", "id": 2,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "qwen_in_flight", "refId": "A" }]
    },
    {
      "type": "stat", "title": "Queue depth", "id": 3,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "qwen_queue_depth", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "Requests/s by status", "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "sum by (status) (rate(qwen_requests_total[1m]))", "refId": "A", "legendFormat": "{{status}}" }]
    },
    {
      "type": "timeseries", "title": "TTFT p50/p95 (s)", "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(qwen_ttft_seconds_bucket[5m])) by (le))", "refId": "A", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(qwen_ttft_seconds_bucket[5m])) by (le))", "refId": "B", "legendFormat": "p95" }
      ]
    },
    {
      "type": "timeseries", "title": "Request duration p50/p95 (s)", "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(qwen_request_duration_seconds_bucket[5m])) by (le))", "refId": "A", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(qwen_request_duration_seconds_bucket[5m])) by (le))", "refId": "B", "legendFormat": "p95" }
      ]
    },
    {
      "type": "timeseries", "title": "Tokens/s", "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{ "expr": "rate(qwen_tokens_generated_total[1m])", "refId": "A", "legendFormat": "tok/s" }]
    },
    {
      "type": "timeseries", "title": "GPU busy / power", "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "mac_gpu_busy_ratio", "refId": "A", "legendFormat": "gpu busy" },
        { "expr": "mac_gpu_power_mw / 1000", "refId": "B", "legendFormat": "gpu W" },
        { "expr": "mac_package_power_mw / 1000", "refId": "C", "legendFormat": "package W" }
      ]
    },
    {
      "type": "timeseries", "title": "Errors/s by kind", "id": 9,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [{ "expr": "sum by (kind) (rate(qwen_errors_total[1m]))", "refId": "A", "legendFormat": "{{kind}}" }]
    },
    {
      "type": "logs", "title": "Logs", "id": 10,
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "targets": [{ "expr": "{job=\"qwen\"}", "refId": "A" }]
    }
  ]
}
