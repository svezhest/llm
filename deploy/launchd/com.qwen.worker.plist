<?xml version="1.0" encoding="UTF-8"?>
<!-- Load: launchctl load -w ~/Library/LaunchAgents/com.qwen.worker.plist
     Edit the paths below to match your checkout / uv location. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.qwen.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/user/.local/bin/uv</string>
    <string>run</string>
    <string>python</string>
    <string>worker.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/user/Projects/llm/src/worker</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- The model: a path relative to WorkingDirectory (or absolute). Without
         QWEN_MODEL the worker loads its built-in default, weights/qwen36-35b-a3b-mlx-ud3
         (the 35B), which needs `sudo sysctl iogpu.wired_limit_mb=28672` re-applied after
         every boot plus QWEN_WIRED_LIMIT_GB / QWEN_PREFILL_STEP (README "Run (dev)").
         The 9B below needs no sysctl, so it is the safe choice for a boot-time agent.
         Add the rest of your recipe (QWEN_PROMPT_CACHE, QWEN_DRAFT, ...) here too. -->
    <key>QWEN_MODEL</key><string>../../weights/ornith15-9b-mlx-8bit</string>
    <key>QWEN_KV_BITS</key><string>0</string>
    <key>LOG_LEVEL</key><string>INFO</string>
    <key>HF_HUB_DISABLE_XET</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/user/Projects/llm/logs/worker.log</string>
  <key>StandardErrorPath</key><string>/Users/user/Projects/llm/logs/worker.log</string>
</dict>
</plist>
